; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WORDERS"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.png"

[autoload]

I18n="*res://scripts/i18n.gd"
Events="*res://scripts/events.gd"
CardDatabase="*res://scripts/card_database.gd"
WordBank="*res://scripts/word_bank.gd"
EmbeddingService="*res://scripts/embedding_service.gd"
TurnManager="*res://scripts/turn_manager.gd"
BattleManager="*res://scripts/battle_manager.gd"
AIController="*res://scripts/ai_controller.gd"
LLMClient="*res://scripts/llm_client.gd"
BattleRecorder="*res://scripts/battle_recorder.gd"
AudioDirector="*res://scripts/audio_director.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[godot_hub]

godot_hub/create_time="2026-05-26 19:08:22.176007"
godot_hub/engine/version="4.6.3-stable"
godot_hub/open_time="2026-05-26 19:08:22.176007"

[gui]

theme/custom="res://resources/default_theme.tres"

[rendering]

textures/vram_compression/import_etc2_astc=true
