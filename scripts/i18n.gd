func t(key: String) -> String:
	return TEXT.get(language, {}).get(key, TEXT[LANG_EN].get(key, key))

func toggle_language() -> void:
	language = LANG_EN if language == LANG_ZH else LANG_ZH
	language_changed.emit()

func pos_label(index: int) -> String:
	return _array_label(POS_LABELS, index)

func component_label(index: int) -> String:
	return _array_label(COMPONENT_LABELS, index)

func content_label(index: int) -> String:
	return _array_label(CONTENT_LABELS, index)

func card_type_label(index: int) -> String:
	return _array_label(TYPE_LABELS, index)

func card_effect_label(index: int) -> String:
	return _array_label(EFFECT_LABELS, index)

func card_name(card: CardData) -> String:
	if card == null:
		return ""
	return CARD_NAMES.get(language, {}).get(card.id, card.card_name)

func _array_label(source: Dictionary, index: int) -> String:
	var values: Array = source.get(language, source[LANG_EN])
	if index >= 0 and index < values.size():
		return values[index]
	return values[values.size() - 1]
